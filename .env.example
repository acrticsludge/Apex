# Apex — example environment. Copy to .env and fill secrets. Never commit .env.
# cp .env.example .env

# ── Deployment ──
APEX_ENV=main
PORT=7000

# ── Dashboard auth / Flask ──
# APEX_SECRET and APEX_PASS are REQUIRED in production. Generate a real one:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If APEX_PASS is unset the app mints a random password and refuses the
# documented defaults, so the dashboard is never reachable with apex/admin.
# Prefer a password hash over plaintext: see APEX_PASS_HASH.
APEX_SECRET=
APEX_USER=apex
APEX_PASS=
# Optional: bcrypt/argon2 hash of the login password. Takes precedence over
# APEX_PASS when set. Generate with:
#   python -c "import secrets,hashlib; print(hashlib.scrypt(b'YOUR-PASSWORD', salt=secrets.token_bytes(16)).hex())"
# and paste the hex as APEX_PASS_HASH=<salt_hex>$<hash_hex>
APEX_PASS_HASH=

# ── Agent mode + capital (overrides cfg defaults) ──
RL_MODE=true
INDIA_CAPITAL=180000
US_CAPITAL=18000

# ── Supabase (state + config persistence, optional — falls back to JSON) ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── JEV TypeSafe overlay ──
JEV_ENABLED=true
JEV_MODEL=jev-latest
TYPE_SAFE_API_KEY=a
JEV_REGIME_CONFIDENCE_THRESHOLD=0.65
JEV_ACTION_CONFIDENCE_THRESHOLD=0.65
JEV_TREND_CONFIDENCE_THRESHOLD=0.70
JEV_NEWS_CONFIDENCE_THRESHOLD=0.70
JEV_HALT_NOUl_THRESHOLD=0.80
JEV_CACHE_TTL_SECONDS=300
JEV_MAX_CALLS_PER_CYCLE=10

# ── RL training data / sentiment ──
TRADING_AGENT_STORAGE_DIR=
RL_TICKERS=
RL_MARKET_UNIVERSE=all
FINNHUB_API_KEY=
ENABLE_SENTIMENT=true
FINNHUB_CHUNK_DAYS=90
FINNHUB_SLEEP_SECONDS=0.4
FINNHUB_TIMEOUT_SECONDS=30
SENTIMENT_FORWARD_FILL_LIMIT=5

# ── RL env / reward ──
RL_INITIAL_CASH=10000
RL_EPISODE_LENGTH=252
RL_MIN_EPISODE_LENGTH=64
RL_SHARPE_REWARD_WEIGHT=0.01
RL_BENCHMARK_REWARD_WEIGHT=1.0
RL_BENCHMARK_OPPORTUNITY_COST_WEIGHT=0.35
RL_FLAT_POSITION_PENALTY=0.0002
RL_FLAT_PENALTY_AFTER_STEPS=8
RL_INVALID_ACTION_PENALTY=0.0005
RL_RANDOM_SEED=42

# ── RL institutional features ──
RL_ENABLE_VWAP=true
RL_ENABLE_VOLUME_PROFILE=true
RL_ENABLE_LIQUIDITY_SWEEPS=true
RL_VWAP_LOOKBACK=30
RL_VP_LOOKBACK=20
RL_SWING_LOOKBACK=20

# ── RL training loop ──
RL_TOTAL_TIMESTEPS=500000
RL_EVAL_FREQ=10000
RL_CHECKPOINT_FREQ=25000
RL_VALIDATION_SHARPE_WEIGHT=1.0
RL_VALIDATION_EXCESS_RETURN_WEIGHT=2.0
RL_VALIDATION_DRAWDOWN_WEIGHT=0.75
RL_VALIDATION_TRADE_COVERAGE_WEIGHT=0.25

# ── RL serve bridge ──
TRADING_AGENT_HOST=0.0.0.0
TRADING_AGENT_PORT=8000
