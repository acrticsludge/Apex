# graphify outputs
graphify-out/
.graphify_*

# Secrets — never commit
.env
error.txt
session.txt

# Python build/test artifacts
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Runtime state and logs — these carried live position sizes, entry prices and
# cash balances into the repo.
apex.log
*.log
# RotatingFileHandler backups. '*.log' does not match 'apex.log.1', and these
# carry the same position sizes and entry prices as the live log — apex.log.1
# was committed by accident before this rule existed.
*.log.*
!*.log.example
apex_dual_state.json
